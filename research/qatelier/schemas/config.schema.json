{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-atelier-lab.local/research/qatelier/schemas/config.schema.json",
  "title": "QAtelier protocol configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "representation",
    "compression",
    "datasets",
    "seeds",
    "metrics",
    "circuit_screening",
    "staged_gates",
    "hardware"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "experiment": {"$ref": "#/$defs/nonEmptyObject"},
    "representation": {"$ref": "#/$defs/nonEmptyObject"},
    "compression": {"$ref": "#/$defs/nonEmptyObject"},
    "datasets": {"$ref": "#/$defs/nonEmptyObject"},
    "seeds": {"$ref": "#/$defs/nonEmptyObject"},
    "metrics": {"$ref": "#/$defs/nonEmptyObject"},
    "circuit_screening": {"$ref": "#/$defs/nonEmptyObject"},
    "staged_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "minProperties": 1}
    },
    "hardware": {"$ref": "#/$defs/nonEmptyObject"}
  },
  "$defs": {
    "nonEmptyObject": {
      "type": "object",
      "minProperties": 1
    }
  }
}

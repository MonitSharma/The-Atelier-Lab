{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-atelier-lab.local/research/qatelier/schemas/result.schema.json",
  "title": "QAtelier experiment result metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "timestamp",
    "question",
    "hypothesis",
    "controls",
    "changed_variables",
    "seed",
    "hardware",
    "software",
    "metrics",
    "artifacts",
    "reproduction"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "question": {"type": "string", "minLength": 1},
    "hypothesis": {"$ref": "#/$defs/hypothesis"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    },
    "changed_variables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/changedVariable"}
    },
    "seed": {"$ref": "#/$defs/seedMetadata"},
    "hardware": {"$ref": "#/$defs/hardwareMetadata"},
    "software": {"$ref": "#/$defs/softwareMetadata"},
    "metrics": {"$ref": "#/$defs/metricResults"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "reproduction": {"$ref": "#/$defs/reproduction"},
    "stage": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "blocked", "partial"]},
    "notes": {"type": "string"}
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "null", "falsifiers"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "null": {"type": "string", "minLength": 1},
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "matched_dimensions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "matched_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "changedVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values", "selection_rule"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1},
        "selection_rule": {"type": "string", "minLength": 1},
        "held_constant": {"type": "boolean"}
      }
    },
    "seedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "split_seed", "purpose"],
      "properties": {
        "value": {"type": "integer"},
        "split_seed": {"type": "integer"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "hardwareMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "provider", "backend"],
      "properties": {
        "execution_mode": {"enum": ["simulator", "emulator", "hardware"]},
        "provider": {"type": ["string", "null"]},
        "backend": {"type": ["string", "null"]},
        "device_qubits": {"type": ["integer", "null"], "minimum": 1},
        "shots": {"type": ["integer", "null"], "minimum": 1},
        "noise_model": {"type": ["string", "null"]},
        "run_timestamp": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "softwareMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "dependencies", "code_revision"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
        "code_revision": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string"},
        "framework": {"type": "string"}
      }
    },
    "metricObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number"},
        "standard_error": {"type": "number", "minimum": 0},
        "confidence_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "n": {"type": "integer", "minimum": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainable_parameter_count": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "circuit_evaluations": {"type": "integer", "minimum": 0},
        "shots": {"type": "integer", "minimum": 0},
        "peak_memory_mb": {"type": "number", "minimum": 0},
        "energy_joules": {"type": "number", "minimum": 0}
      }
    },
    "metricResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "uncertainty", "resources"],
      "properties": {
        "primary": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/metricObservation"}
        },
        "secondary": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/metricObservation"}
        },
        "uncertainty": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/metricObservation"}
        },
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "purpose"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "environment", "data_manifest", "config_path"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "data_manifest": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "expected_outputs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
